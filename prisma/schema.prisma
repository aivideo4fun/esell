datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// 1. Users (Admin, Staff, Customers)
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  phone     String?  @unique
  password  String?
  role      String   @default("CUSTOMER") // CUSTOMER, ADMIN, STAFF
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlists    Wishlist[]
  activityLogs ActivityLog[]
  tickets      SupportTicket[]
}

// 2. Customers (Fast OTP / WhatsApp Checkout)
model Customer {
  id        String   @id @default(cuid())
  phone     String?  @unique
  email     String?  @unique
  name      String?
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// 3. Verification OTPs
model VerificationOtp {
  id         String   @id @default(cuid())
  identifier String
  otp        String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
}
// 4. Categories & Subcategories
model Category {
  id            String     @id @default(cuid())
  name          String     @unique
  slug          String     @unique
  icon          String?
  description   String?
  displayOrder  Int        @default(0)
  parentId      String?
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  subCategories Category[] @relation("SubCategories")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
}

// 5. Products (With Clothes Size/Color & Inventory Sync)
model Product {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String?
  price         Float
  originalPrice Float
  stock         Int      @default(100)
  sku           String?  @unique
  barcode       String?
  badge         String?
  rating        Float    @default(4.8)
  reviewCount   Int      @default(0)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)

  // Clothes & Variants Array Support
  sizes         String[] @default([]) // e.g. ["S", "M", "L", "XL", "XXL"]
  colors        String[] @default([]) // e.g. ["Black", "White", "Navy Blue"]

  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])

  isAmazonSynced Boolean @default(false)
  amazonAsin     String?

  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]
  wishlists  Wishlist[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([categoryId])
  @@index([slug])
}

// 6. Product Images
model ProductImage {
  id        String  @id @default(cuid())
  url       String
  isPrimary Boolean @default(false)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 7. Addresses
model Address {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  orders    Order[]
  createdAt DateTime @default(now())
}

// 8. Orders (With Coupon Tracking)
model Order {
  id             String    @id @default(cuid())
  orderNumber    String?   @unique
  
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])

  addressId      String
  address        Address   @relation(fields: [addressId], references: [id])

  totalAmount    Float
  discountAmount Float     @default(0)
  couponCode     String?

  orderStatus    String    @default("PAID") // PENDING, PAID, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentStatus  String    @default("SUCCESS") // PENDING, SUCCESS, FAILED, REFUNDED

  supplierStatus String    @default("PENDING_MANUAL_ORDER")
  trackingNumber String?
  trackingUrl    String?
  channel        String    @default("WEBSITE")

  items          OrderItem[]
  payments       Payment[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderStatus])
  @@index([createdAt])
}

// 9. Order Items (With selected variant snapshot)
model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int
  price         Float
  selectedSize  String?
  selectedColor String?
}

// 10. Payments & Transactions
model Payment {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway      String   @default("RAZORPAY")
  gatewayTxnId String   @unique
  amount       Float
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())
}

// 11. Customer Reviews & Ratings
model Review {
  id           String   @id @default(cuid())
  customerName String?
  rating       Int      @default(5)
  comment      String?
  images       String[] @default([])
  status       String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([productId])
}

// 12. Wishlists
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// 13. Advanced Coupons & Promotions
model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    @default("PERCENTAGE") // PERCENTAGE, FLAT, FREE_SHIPPING
  discountValue Float
  minOrderValue Float     @default(0)
  maxDiscount   Float?
  usageLimit    Int?
  usageCount    Int       @default(0)
  isActive      Boolean   @default(true)
  validFrom     DateTime  @default(now())
  validTo       DateTime?
  createdAt     DateTime  @default(now())
}

// 14. Banners & Homepage Sliders (CMS)
model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  badgeText   String?
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
}

// 15. Customer Support Tickets
model SupportTicket {
  id          String   @id @default(cuid())
  ticketNumber String  @unique
  subject     String
  message     String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  customerPhone String?
  customerEmail String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 16. Security & Audit Activity Logs
model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  ipAddress String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}